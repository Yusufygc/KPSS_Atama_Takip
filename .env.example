# KPSS Atama Takip - Örnek Ortam Değişkenleri
# Gerçek değerleriniz için bu dosyayı '.env' olarak kopyalayıp düzenleyin.

# Uygulama Ayarları
APP_ENV=development
APP_DEBUG=true
# Yerel geliştirmede 127.0.0.1 kullanın; Docker bu değeri kendisi 0.0.0.0 yapar.
APP_HOST=127.0.0.1
APP_PORT=8000

# Güvenlik
# Tarama tetikleme ve ayarlar uç noktaları için X-API-Key değeri.
# Prodüksiyonda ZORUNLUDUR (boşsa bu uç noktalar 503 döner). Örn: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Virgülle ayrılmış CORS kaynakları (Web UI aynı origin'den sunulduğu için genelde boş bırakılır)
CORS_ORIGINS=

# Veritabanı
DATABASE_PATH=data/kpss_atama.db

# Telegram Bildirim Ayarları
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=false

# Tarayıcı / Kazıyıcı Zamanlayıcı Ayarları
SCRAPER_INTERVAL_MINUTES=15
SCRAPER_CONCURRENT_WORKERS=3
# Açılışta ilk taramayı bekletmeden başlat (gecikme saniye cinsinden)
SCRAPER_RUN_ON_STARTUP=true
SCRAPER_STARTUP_DELAY_SECONDS=20
# İlan.gov.tr için Chrome/Edge/Chromium yolu (boşsa otomatik aranır)
BROWSER_EXECUTABLE_PATH=

# Hangi ilanlar Telegram'a gitsin: p3_or_it (P3 veya bilgisayar/bilişim, varsayılan) | p3_and_it | p3 | it | all
# Filtreye uymayanlar da kaydedilir ve web panelinde görünür; yalnızca bildirim gitmez.
TELEGRAM_NOTIFY_FILTER=p3_or_it
# Telegram bildirim davranışı
# Boş veritabanında ilk taramada bulunan mevcut ilanlar için bildirim gönderilsin mi?
NOTIFY_ON_FIRST_RUN=false
# Tek taramada tek tek gönderilecek en fazla bildirim (fazlası tek özet mesajı olur)
TELEGRAM_MAX_PER_CYCLE=15
TELEGRAM_SEND_INTERVAL_SECONDS=1.1
# Gönderilemeyen bildirimler bu kadar saat boyunca yeniden denenir
TELEGRAM_RETRY_WINDOW_HOURS=24

# Bir portal art arda bu kadar taramada hata verirse tek bir Telegram uyarısı gelir (0 = kapalı)
PORTAL_FAILURE_ALERT_THRESHOLD=3

# Günlük veritabanı yedeği (TRT saatiyle DB_BACKUP_HOUR; en yeni DB_BACKUP_KEEP yedek tutulur)
DB_BACKUP_ENABLED=true
DB_BACKUP_DIR=data/backups
DB_BACKUP_KEEP=7
DB_BACKUP_HOUR=4

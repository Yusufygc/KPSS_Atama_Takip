# KPSS Atama Takip - SUNUCU (üretim) ortam değişkenleri örneği.
# setup-vm.sh bu dosyayı ".env" olarak kopyalar. Aşağıdaki <...> alanlarını doldurun.
# Bu dosya gerçek bilgi içermez; ".env" ise asla git'e eklenmemelidir (.gitignore'dadır).

APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Güvenlik (ZORUNLU) ---
# Üretimde boşsa "Şimdi Tara" ve ayarlar uç noktaları 503 verir. Üretin:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=<UZUN-RASTGELE-ANAHTAR>
CORS_ORIGINS=

# --- Telegram ---
# Bot token: Telegram'da @BotFather > /newbot.  Chat ID: bota /start yazın, sonra
#   https://api.telegram.org/bot<TOKEN>/getUpdates  adresindeki "chat":{"id": ...} değeri.
TELEGRAM_BOT_TOKEN=<BOT-TOKEN>
TELEGRAM_CHAT_ID=<CHAT-ID>
TELEGRAM_NOTIFICATIONS_ENABLED=true

# Boş veritabanıyla ilk açılışta mevcut yüzlerce ilan için mesaj YAĞMAMASI için kapalı bırakın.
NOTIFY_ON_FIRST_RUN=false
TELEGRAM_MAX_PER_CYCLE=15
TELEGRAM_SEND_INTERVAL_SECONDS=1.1
TELEGRAM_RETRY_WINDOW_HOURS=24
# Bir portal art arda bu kadar taramada hata verirse tek bir uyarı gelir (0 = kapalı)
PORTAL_FAILURE_ALERT_THRESHOLD=3

# --- Tarama ---
DATABASE_PATH=data/kpss_atama.db
SCRAPER_INTERVAL_MINUTES=15
SCRAPER_CONCURRENT_WORKERS=3
SCRAPER_RUN_ON_STARTUP=true
SCRAPER_STARTUP_DELAY_SECONDS=20

# --- Yedekleme (günlük 04:00 TRT, data/backups/ içinde, en yeni 7 yedek tutulur) ---
DB_BACKUP_ENABLED=true
DB_BACKUP_DIR=data/backups
DB_BACKUP_KEEP=7
DB_BACKUP_HOUR=4

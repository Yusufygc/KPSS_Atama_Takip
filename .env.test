# KPSS Atama Takip - TEST ortami ayarlari (gizli bilgi icermez, git ile paylasilir)
# Kullanim: python run.py --test   |   baslat-test.bat   |   docker compose -f docker-compose.test.yml up
#
# Bu ortam gercek Telegram botuna ve gercek veritabanina ERISEMEZ:
#  - APP_ENV=test iken app/config.py Telegram ayarlarini zorla bosaltir ve kapatir
#  - APP_ENV=test iken data/kpss_atama.db (gercek DB) kullanilmasi hata verir
APP_ENV=test
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8001
DATABASE_PATH=data/test/kpss_test.db

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=false

SCRAPER_INTERVAL_MINUTES=15
SCRAPER_CONCURRENT_WORKERS=3
# Test ortaminda taramayi elle ("Simdi Tara") baslatirsiniz; acilista otomatik tarama yok
SCRAPER_RUN_ON_STARTUP=false
